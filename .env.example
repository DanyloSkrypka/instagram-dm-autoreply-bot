# Copy to .env and fill in. Never commit .env.

# --- Instagram Platform (official API) ---
# instagram = Instagram API with Instagram Login (graph.instagram.com, no Facebook Page needed)
# facebook  = Instagram API with Facebook Login (graph.facebook.com, IG account linked to a Facebook Page)
IG_LOGIN_TYPE=instagram
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=choose-a-long-random-string
GRAPH_API_VERSION=v27.0

# --- Business ---
SHOP_FILE=app/shop.json
DEFAULT_LANG=en
# comment keywords that trigger the DM (whole word, case-insensitive)
COMMENT_KEYWORDS=PRICE,PREIS,ЦЕНА
# also answer the comment publicly ("Sent you a DM")
PUBLIC_COMMENT_REPLY=1
# after a handover the bot stays silent this long unless the owner hands back earlier
HANDOVER_TIMEOUT_H=12
# optional: JSON POST on every handover (Slack/Telegram relay, Make/n8n webhook)
OWNER_ALERT_URL=
# protects /admin/* (header X-Admin-Token); empty = admin endpoints disabled
ADMIN_TOKEN=

# --- Storage ---
DB_PATH=data/bot.db
LEADS_CSV=data/leads.csv

# 1 = local emulator at /demo (only active while IG_ACCESS_TOKEN is empty). Set 0 in production.
DEMO_MODE=0
